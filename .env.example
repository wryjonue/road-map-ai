# Render AI Service Environment Variables
# Copy this file to .env and fill in the values for local development.
# For production, set these in the Render dashboard.

# Server port (Render provides this automatically)
PORT=3000

# Google Gemini API Key for AI moderation
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for HMAC signature verification (must match Cloudflare Worker secret)
AI_WEBHOOK_SECRET=technoblade-never-dies

# Cloudflare Worker webhook URL to receive moderation results
WORKER_WEBHOOK_URL=https://your-worker-domain.example.com/api/webhooks/ai-moderation

# Cloudflare R2 credentials for fetching report images
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=road-map-media
R2_S3_ENDPOINT=https://f9b15912d20e35772cab969a73f05b3e.r2.cloudflarestorage.com